<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputPath Condition="'$(DuelTestPattern)' != ''">bin/partition-$(DuelTestPattern)/$(Configuration)/</OutputPath>
    <IntermediateOutputPath Condition="'$(DuelTestPattern)' != ''">obj/partition-$(DuelTestPattern)/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/AChen.Duel.Core/AChen.Duel.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(DuelTestPattern)' != ''">
    <Compile Remove="*.cs" />
    <Compile Include="$(DuelTestPattern)" />
  </ItemGroup>
</Project>
