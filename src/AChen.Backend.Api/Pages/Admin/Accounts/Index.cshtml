@page "/admin/accounts"
@model AChen.Backend.Api.Pages.Admin.Accounts.IndexModel
@{
    ViewData["Title"] = "账号管理";
}

<div class="page-heading account-heading">
    <div>
        <p class="eyebrow">ACCOUNTS</p>
        <h1>账号管理</h1>
        <p class="muted">查看玩家账号与基础资料。密码哈希和令牌不会显示在此页面。</p>
    </div>
    <div class="account-total">
        <strong>@Model.Accounts.TotalItems</strong>
        <span>个账号</span>
    </div>
</div>

<form class="filters account-filters" method="get">
    <label>搜索用户名
        <input name="search" value="@Model.Search" placeholder="输入完整或部分用户名" autocomplete="off" />
    </label>
    <button class="primary" type="submit">搜索</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="button" asp-page="/Admin/Accounts/Index">清除</a>
    }
</form>

<div class="table-wrap account-table-wrap">
    <table class="account-table">
        <thead>
        <tr>
            <th>账号</th>
            <th>玩家资料</th>
            <th>金币</th>
            <th>登录会话</th>
            <th>创建时间</th>
            <th>更新时间</th>
            <th><span class="sr-only">操作</span></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var account in Model.Accounts.Items)
        {
            <tr>
                <td>
                    <strong>@account.Username</strong>
                    <small class="account-id">@account.Id</small>
                </td>
                <td>
                    @if (account.Nickname is null)
                    {
                        <span class="muted">未创建</span>
                    }
                    else
                    {
                        <span>@account.Nickname</span>
                    }
                </td>
                <td>@(account.Gold?.ToString("N0") ?? "—")</td>
                <td><span class="status">@account.RefreshSessionCount</span></td>
                <td><time datetime="@account.CreatedAt.ToString("O")">@account.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time></td>
                <td><time datetime="@account.UpdatedAt.ToString("O")">@account.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time></td>
                <td class="account-actions">
                    <a class="button" asp-page="/Admin/Accounts/Edit" asp-route-id="@account.Id">编辑数据</a>
                    <button class="ghost-danger"
                            type="button"
                            data-delete-account
                            data-account-id="@account.Id"
                            data-account-name="@account.Username">删除</button>
                </td>
            </tr>
        }
        @if (Model.Accounts.Items.Count == 0)
        {
            <tr><td colspan="7" class="empty">没有找到符合条件的账号</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Accounts.TotalPages > 1)
{
    <nav class="pagination" aria-label="账号列表分页">
        @if (Model.Accounts.Page > 1)
        {
            <a class="button" asp-route-page="@(Model.Accounts.Page - 1)" asp-route-search="@Model.Search">上一页</a>
        }
        <span>第 @Model.Accounts.Page / @Model.Accounts.TotalPages 页</span>
        @if (Model.Accounts.Page < Model.Accounts.TotalPages)
        {
            <a class="button" asp-route-page="@(Model.Accounts.Page + 1)" asp-route-search="@Model.Search">下一页</a>
        }
    </nav>
}

<dialog class="confirm-dialog" id="delete-account-dialog" aria-labelledby="delete-account-dialog-title">
    <div class="dialog-kicker">DELETE ACCOUNT</div>
    <h2 id="delete-account-dialog-title">确认删除账号？</h2>
    <p>账号 <strong data-delete-account-name></strong>、玩家资料及所有刷新会话将被永久删除，此操作无法撤销。</p>
    <form method="post" asp-page-handler="Delete" data-delete-account-form>
        <input type="hidden" name="id" data-delete-account-id />
        <input type="hidden" name="page" value="@Model.Accounts.Page" />
        <input type="hidden" name="search" value="@Model.Search" />
        <div class="dialog-actions">
            <button type="button" data-cancel-delete>取消</button>
            <button class="danger" type="submit">永久删除</button>
        </div>
    </form>
</dialog>

<script src="~/js/account-admin.js" asp-append-version="true"></script>
