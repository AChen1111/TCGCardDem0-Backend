@page "/admin/content"
@model AChen.Backend.Api.Pages.Admin.Content.IndexModel
@{
    ViewData["Title"] = "发布版本";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">RELEASES</p>
        <h1>内容发布版本</h1>
        <p class="muted">DLL、Catalog 和 AssetBundle 始终作为一个不可变版本发布。</p>
    </div>
    <a class="button primary" asp-page="/Admin/Content/New">上传新版本</a>
</div>

<form class="filters" method="get">
    <label>平台
        <select name="platform">
            <option value="">全部</option>
            @foreach (var platform in Model.Platforms)
            {
                <option value="@platform" selected="@(platform == Model.Platform)">@platform</option>
            }
        </select>
    </label>
    <label>App 版本
        <input name="appVersion" value="@Model.AppVersion" />
    </label>
    <label>状态
        <select name="state">
            <option value="">全部</option>
            @foreach (var state in Model.States)
            {
                <option value="@state" selected="@(state == Model.State)">@state</option>
            }
        </select>
    </label>
    <button type="submit">筛选</button>
</form>

<div class="table-wrap">
    <table>
        <thead>
        <tr><th>内容版本</th><th>平台</th><th>App</th><th>状态</th><th>文件</th><th>大小</th><th>创建时间</th></tr>
        </thead>
        <tbody>
        @foreach (var release in Model.Releases.Items)
        {
            <tr>
                <td><a asp-page="/Admin/Content/Details" asp-route-id="@release.Id">@release.ContentVersion</a></td>
                <td>@release.Platform</td>
                <td>@release.AppVersion</td>
                <td><span class="status @release.State.ToLowerInvariant()">@release.State</span></td>
                <td>@release.FileCount</td>
                <td>@Model.FormatBytes(release.TotalBytes)</td>
                <td>@release.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
        @if (Model.Releases.Items.Count == 0)
        {
            <tr><td colspan="7" class="empty">暂无发布版本</td></tr>
        }
        </tbody>
    </table>
</div>
