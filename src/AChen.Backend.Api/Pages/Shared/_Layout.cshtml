<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AChen 后台</title>
    <link rel="stylesheet" href="~/css/content-admin.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Admin/Accounts/Index">AChen 后台</a>
        <nav>
            <a asp-page="/Admin/Accounts/Index">账号管理</a>
        </nav>
    </header>
    <main class="shell">
        @if (TempData["Message"] is string message)
        {
            <div class="notice success" role="status">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="notice error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>
