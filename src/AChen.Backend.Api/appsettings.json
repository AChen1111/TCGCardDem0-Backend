{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=Data/achen.db"
  },
  "Auth": {
    "Issuer": "AChen.Backend",
    "Audience": "AChen.Game",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ContentDelivery": {
    "StorageRoot": "Data/content",
    "PublishKey": "",
    "MaxArchiveBytes": 2147483648,
    "MaxExpandedBytes": 4294967296,
    "MaxFileCount": 10000,
    "AllowedChannels": [
      "development"
    ]
  },
  "GameConfigGit": {
    "RepositoryRoot": "Data/game-config-git",
    "Branch": "main",
    "RemoteName": "origin",
    "RemoteUrl": "",
    "HistoryLimit": 30
  }
}
