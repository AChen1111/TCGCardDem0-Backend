@host = http://127.0.0.1:5080
@accessToken = paste-access-token-here
@refreshToken = paste-refresh-token-here
@publishKey = paste-content-publish-key-here
@releaseId = 00000000-0000-0000-0000-000000000000

GET {{host}}/health
Accept: application/json

###

POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "LocalPlayer",
  "email": "local@example.com",
  "password": "correct-horse-42"
}

###

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "identifier": "LocalPlayer",
  "password": "correct-horse-42"
}

###

GET {{host}}/api/auth/me
Authorization: Bearer {{accessToken}}

###

GET {{host}}/api/player/bootstrap
Authorization: Bearer {{accessToken}}

###

PATCH {{host}}/api/player/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "nickname": "Local Player",
  "avatarId": 1,
  "expectedRevision": 0
}

###

GET {{host}}/api/game-config/bootstrap
Accept: application/json

### Replace the ETag after publishing a configuration from /admin/game-config.

GET {{host}}/api/game-config/bootstrap
Accept: application/json
If-None-Match: "game-config-1"

###

POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

POST {{host}}/api/content/releases
X-Content-Publish-Key: {{publishKey}}
Content-Type: application/json

{
  "platform": "StandaloneWindows64",
  "appVersion": "0.1.0",
  "contentVersion": "0.1.1",
  "notes": "first backend release"
}

###

GET {{host}}/api/content/releases?page=1&pageSize=20&platform=StandaloneWindows64
X-Content-Publish-Key: {{publishKey}}

###

GET {{host}}/api/content/releases/{{releaseId}}
X-Content-Publish-Key: {{publishKey}}

### Upload the ZIP with Unity's Build And Publish Release window; raw binary bodies are not embedded here.

PUT {{host}}/api/content/active-releases/development/StandaloneWindows64/0.1.0
X-Content-Publish-Key: {{publishKey}}
Content-Type: application/json

{
  "releaseId": "{{releaseId}}",
  "expectedCurrentReleaseId": null
}

###

GET {{host}}/api/content/manifests/latest?channel=development&platform=StandaloneWindows64&appVersion=0.1.0

###

POST {{host}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
